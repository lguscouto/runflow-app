{
  "name": "runflow",
  "version": "0.9.8",
  "private": true,
  "description": "App open source para gerenciar treinos de corrida — importação Amazfit/Zepp via GPX e FIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/build/patch-file-export.mjs",
    "build:mobile": "npm run build && npx cap sync android && cd android && gradlew assembleDebug",
    "start": "npx serve out",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "cap:run": "npx cap run android",
    "quality:versions": "node scripts/quality/version-consistency.mjs",
    "quality:contrast": "vitest run src/lib/contrast.test.ts src/lib/color-tokens.test.ts",
    "quality:legacy": "node scripts/android/audit-legacy.mjs",
    "perf:bundle": "node scripts/perf/bundle-budget.mjs"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^7.1.1",
    "@capacitor/android": "^7.2.0",
    "@capacitor/app": "^7.0.1",
    "@capacitor/core": "^7.2.0",
    "@capacitor/filesystem": "^7.1.2",
    "@capacitor/geolocation": "^7.1.2",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/share": "^7.0.2",
    "@capacitor/status-bar": "^7.0.1",
    "@tanstack/react-virtual": "^3.14.10",
    "@types/three": "^0.185.4",
    "canvas-confetti": "^1.9.4",
    "date-fns": "^4.1.0",
    "fit-file-parser": "^1.9.0",
    "idb": "^8.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.511.0",
    "next": "15.5.23",
    "peerjs": "^1.5.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-leaflet": "^5.0.0",
    "three": "^0.185.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.2.0",
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.8",
    "@testing-library/react": "^16.3.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/leaflet": "^1.9.18",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.27.0",
    "eslint-config-next": "15.5.23",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.26",
      "sharp": "0.35.3"
    }
  },
  "capacitor": {
    "android": {
      "path": "android"
    }
  }
}
